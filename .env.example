# Copy to .env and run with: uv run --env-file .env azure-news ingest
# In GitHub Actions, ANTHROPIC_API_KEY comes from a repository secret.

# --- Summarisation ---
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_NEWS_SUMMARIZER=claude            # or "heuristic": keyword rules, no API key, rough results
# AZURE_NEWS_MODEL=claude-opus-5-5
# AZURE_NEWS_REFUSAL_FALLBACKS=1          # 0 to stop sending the server-side fallback beta flag
# AZURE_NEWS_MIN_IMPORTANCE=4             # 1-5; raise to 5 for fewer, bigger items
# AZURE_NEWS_MIN_ARCHITECTURE_RELEVANCE=3 # 1-5; below this an item is not published
# AZURE_NEWS_MAJOR_ARCHITECTURE_RELEVANCE=4 # 1-5; below this an item is hidden behind the filter
# AZURE_NEWS_BATCH_SIZE=20

# --- Ingest ---
# AZURE_NEWS_MAX_AGE_DAYS=30              # ignore feed items older than this
# AZURE_NEWS_RETENTION_DAYS=180           # drop published items older than this
# AZURE_NEWS_FEED_TTL_MINUTES=30          # reuse a cached feed within this window

# --- Email notification (Azure Communication Services) ---
# Off unless the first three are set. Sent by: uv run --env-file .env azure-news notify
# AZURE_NEWS_ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=...
# AZURE_NEWS_NOTIFY_FROM=DoNotReply@<domain>  # a sender on a domain linked to the resource
# AZURE_NEWS_NOTIFY_TO=a@example.com,b@example.com
# AZURE_NEWS_NOTIFY_TIER=major            # or "all" to include the smaller updates
# AZURE_NEWS_SITE_URL=https://<user>.github.io/azure-news/  # linked from the email

# --- Paths (relative to the repository root) ---
# AZURE_NEWS_DATA_DIR=site/data           # news.json, published with the site
# AZURE_NEWS_STATE_DIR=state              # assessments.json, notifications.json and the local feed cache
