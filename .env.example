# Copy to .env and run with: uv run --env-file .env azure-news ingest
# In GitHub Actions, ANTHROPIC_API_KEY comes from a repository secret.

# --- Summarisation ---
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_NEWS_SUMMARIZER=claude            # or "heuristic": keyword rules, no API key, rough results
# AZURE_NEWS_MODEL=claude-opus-5-5
# AZURE_NEWS_REFUSAL_FALLBACKS=1          # 0 to stop sending the server-side fallback beta flag
# AZURE_NEWS_MIN_IMPORTANCE=4             # 1-5; raise to 5 for fewer, bigger items
# AZURE_NEWS_MIN_ARCHITECTURE_RELEVANCE=3 # 1-5
# AZURE_NEWS_BATCH_SIZE=20

# --- Ingest ---
# AZURE_NEWS_MAX_AGE_DAYS=30              # ignore feed items older than this
# AZURE_NEWS_RETENTION_DAYS=180           # drop published items older than this
# AZURE_NEWS_FEED_TTL_MINUTES=30          # reuse a cached feed within this window

# --- Paths (relative to the repository root) ---
# AZURE_NEWS_DATA_DIR=site/data           # news.json, published with the site
# AZURE_NEWS_STATE_DIR=state              # assessments.json and the local feed cache
